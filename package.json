{
  "name": "@noflo/gravatar",
  "description": "Gravatar components for NoFlo",
  "version": "2.0.0-alpha.1",
  "author": {
    "name": "Henri Bergius",
    "email": "henri.bergius@iki.fi",
    "url": "http://bergie.iki.fi"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/noflo/noflo-gravatar.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "noflo": {
    "icon": "user"
  },
  "keywords": [
    "noflo"
  ],
  "files": [
    "components/",
    "spec/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@noflo/noflo": "^2.0.0-alpha.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@noflo/fbp-spec-runner": "^2.0.0-alpha.2",
    "@noflo/loader-node": "^2.0.0-alpha.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "lint": "npx @biomejs/biome check --use-editorconfig=true components/ spec/",
    "format": "npx @biomejs/biome check --use-editorconfig=true --write components/ spec/",
    "types": "tsc -p tsconfig.json",
    "test": "npm run types && npm run lint && npm run test:spec",
    "test:spec": "node \"$(node -p \"require.resolve('@noflo/fbp-spec-runner/src/cli.js')\")\" spec/"
  }
}
